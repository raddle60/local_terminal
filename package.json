{
  "name": "local-terminal",
  "version": "1.0.0",
  "description": "Local Terminal Manager with profile management",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc && npm run bundle:renderer && npm run copy-assets",
    "bundle:renderer": "node scripts/bundle-renderer.js",
    "copy-assets": "node scripts/copy-assets.js",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "node-pty": "^1.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "build": {
    "appId": "com.local.terminal",
    "productName": "Local Terminal",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    }
  }
}
